{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edoc.local/schema/v1/register.schema.json",
  "type": "object",
  "properties": {
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "kind": {
            "const": "register"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "gapPolicy": {
            "enum": [
              "unspecified",
              "reserved"
            ]
          },
          "description": {
            "type": "string"
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "kind": {
                  "const": "register-field"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "msb": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "lsb": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "access": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "source": {
                  "$ref": "common.schema.json#/$defs/source"
                },
                "reset": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "string",
                          "pattern": "^(0[xX][0-9a-fA-F]+|0[bB][01]+|[0-9]+)$"
                        }
                      },
                      "required": [
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "expression": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "expression"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "unknown": {
                          "const": true
                        }
                      },
                      "required": [
                        "unknown"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "label",
                "msb",
                "lsb"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "label",
          "width",
          "fields"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "registers"
  ],
  "additionalProperties": false
}
