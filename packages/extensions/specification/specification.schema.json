   "id":{"$ref":"common.schema.json#/$defs/id"},"kind":{"const":"specification"},
   "label":{"type":"string","minLength":1},
   "body":{"type":"object","properties":{"format":{"const":"markdoc"},"content":{"type":"string","minLength":1}},"required":["format","content"],"additionalProperties":false},
   "source":{"$ref":"common.schema.json#/$defs/source"}
