{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edoc.local/schema/v1/address-space.schema.json",
  "type": "object",
  "properties": {
    "addressSpaces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          },
          "kind": {
            "const": "address-space"
          },
          "addressUnitBits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "addressWidth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "$ref": "common.schema.json#/$defs/source"
                },
                "block": {
                  "$ref": "common.schema.json#/$defs/id"
                },
                "base": {
                  "type": "string",
                  "pattern": "^(0[xX][0-9a-fA-F]+|[0-9]+)$"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "stride": {
                  "type": "string",
                  "pattern": "^(0[xX][0-9a-fA-F]+|[0-9]+)$"
                }
              },
              "required": [
                "id",
                "block",
                "base"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "kind",
          "mappings"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "addressSpaces"
  ],
  "additionalProperties": false
}
