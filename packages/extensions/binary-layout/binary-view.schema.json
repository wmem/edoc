{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edoc.local/schema/v2/binary-view.schema.json",
  "$defs": {
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        },
        "kind": {
          "const": "binary-layout"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "bitsPerRow": {
          "enum": [
            8,
            16,
            32,
            64
          ]
        },
        "collapsed": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        },
        "focus": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "values": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "kind",
        "model"
      ],
      "additionalProperties": false
    }
  }
}
