{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edoc.local/schema/v1/view.schema.json",
  "type": "object",
  "properties": {
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "architecture",
              "interface",
              "wiring",
              "state"
            ]
          },
          "include": {
            "type": "object",
            "properties": {
              "objects": {
                "$ref": "common.schema.json#/$defs/ids"
              },
              "relations": {
                "$ref": "common.schema.json#/$defs/ids"
              }
            },
            "required": [
              "objects",
              "relations"
            ],
            "additionalProperties": false
          },
          "layout": {
            "type": "object",
            "properties": {
              "direction": {
                "enum": [
                  "LR",
                  "RL",
                  "TB",
                  "BT"
                ]
              },
              "routing": {
                "enum": [
                  "orthogonal",
                  "polyline"
                ]
              },
              "portOrder": {
                "$ref": "common.schema.json#/$defs/ids"
              },
              "positions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "objectId": {
                      "$ref": "common.schema.json#/$defs/id"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "objectId",
                    "x",
                    "y"
                  ],
                  "additionalProperties": false
                }
              },
              "interfaceOrder": {
                "$ref": "common.schema.json#/$defs/ids"
              },
              "interfaceSides": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "left",
                    "right"
                  ]
                }
              },
              "constraints": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "order"
                        },
                        "axis": {
                          "enum": [
                            "x",
                            "y"
                          ]
                        },
                        "nodes": {
                          "type": "array",
                          "items": {
                            "$ref": "common.schema.json#/$defs/id"
                          },
                          "minItems": 2,
                          "uniqueItems": true
                        },
                        "gap": {
                          "type": "number",
                          "minimum": 16
                        }
                      },
                      "required": [
                        "type",
                        "axis",
                        "nodes"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "align"
                        },
                        "axis": {
                          "enum": [
                            "x",
                            "y"
                          ]
                        },
                        "nodes": {
                          "type": "array",
                          "items": {
                            "$ref": "common.schema.json#/$defs/id"
                          },
                          "minItems": 2,
                          "uniqueItems": true
                        }
                      },
                      "required": [
                        "type",
                        "axis",
                        "nodes"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "relationHints": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "backbone": {
                      "type": "array",
                      "items": {
                        "$ref": "common.schema.json#/$defs/id"
                      },
                      "minItems": 2,
                      "uniqueItems": true,
                      "maxItems": 2
                    },
                    "endpointSides": {
                      "type": "object",
                      "additionalProperties": {
                        "enum": [
                          "left",
                          "right",
                          "top",
                          "bottom"
                        ]
                      }
                    },
                    "channel": {
                      "enum": [
                        "left",
                        "right",
                        "top",
                        "bottom"
                      ]
                    },
                    "priority": {
                      "enum": [
                        "main",
                        "normal"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "display": {
            "type": "object",
            "properties": {
              "showPortAttributes": {
                "type": "boolean"
              },
              "showRelationLabels": {
                "type": "boolean"
              },
              "portAttributes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "collapsedGroups": {
                "$ref": "common.schema.json#/$defs/ids"
              },
              "classes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "interfaceMode": {
                "enum": [
                  "collapsed",
                  "expanded"
                ]
              },
              "interfaceOverrides": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    "collapsed",
                    "expanded"
                  ]
                }
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "source": {
            "$ref": "common.schema.json#/$defs/source"
          }
        },
        "required": [
          "id",
          "kind",
          "include"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "views"
  ],
  "additionalProperties": false
}
