{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edoc.local/schema/v1/manifest.schema.json",
  "type": "object",
  "properties": {
    "irVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "projectId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "objects",
              "relations",
              "views",
              "tables",
              "waveforms",
              "references"
            ]
          },
          "path": {
            "$ref": "common.schema.json#/$defs/path"
          }
        },
        "required": [
          "type",
          "path"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "entryDocuments": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/path"
      },
      "uniqueItems": true
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "requiredFeatures": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "irVersion",
    "projectId",
    "resources",
    "entryDocuments"
  ],
  "additionalProperties": false
}
