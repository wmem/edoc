        {
          "id": "reg:port-status-link",
          "label": "链路有效",
          "msb": 0,
          "lsb": 0,
          "access": "RO"
        }
      ],
      "source": {
        "file": "docs/ir/authoring/register-maps.json",
        "selector": "reg:port-status"
      }
    }
