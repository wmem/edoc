{
  "sequences": [
    {
      "id": "seq:request",
      "kind": "sequence",
      "label": "请求与应答",
      "participants": [
        {
          "id": "host",
          "label": "主机"
        },
        {
          "id": "fpga",
          "label": "FPGA"
        }
      ],
      "steps": [
        {
          "id": "request",
          "from": "host",
          "to": "fpga",
          "label": "读取状态"
        },
        {
          "id": "reply",
          "from": "fpga",
          "to": "host",
          "label": "状态应答",
          "mode": "return",
          "replyTo": "request"
        }
      ],
      "source": {
        "file": "docs/ir/authoring/sequences.json",
        "selector": "seq:request"
      }
    },
    {
      "id": "seq:auth",
      "kind": "sequence",
      "label": "升级鉴权子交互",
      "participants": [
        {
          "id": "client",
          "label": "请求方"
        },
        {
          "id": "service",
          "label": "设备"
        }
      ],
      "steps": [
        {
          "id": "challenge",
          "from": "client",
          "to": "service",
          "label": "发送签名",
          "mode": "call"
        },
        {
          "id": "verified",
          "from": "service",
          "to": "client",
          "label": "验证通过",
          "mode": "return",
          "replyTo": "challenge"
        }
      ],
      "source": {
        "file": "docs/ir/authoring/sequences.json",
        "selector": "seq:auth"
      }
    },
    {
      "id": "seq:upgrade",
      "kind": "sequence",
      "label": "固件升级：逐块确认、有限重试与明确结局",
      "participants": [
        {
          "id": "host",
          "label": "主机驱动"
        },
        {
          "id": "mcu",
          "label": "管理 MCU"
        },
        {
          "id": "flash",
          "label": "Flash"
        },
        {
          "id": "monitor",
          "label": "监测服务"
        }
      ],
      "steps": [
        {
          "id": "begin",
          "from": "host",
          "to": "mcu",
          "label": "请求升级",
          "mode": "call",
          "protocol": "binary:packet"
        },
        {
          "id": "authenticate",
          "kind": "ref",
          "model": "seq:auth",
          "participants": {
            "client": "host",
            "service": "mcu"
          }
        },
        {
          "id": "write-loop",
          "kind": "loop",
          "guard": "仍有待写数据块，且升级尚未失败",
          "label": "逐块推进：确认后才取下一块",
          "steps": [
            {
              "id": "attempt-loop",
              "kind": "loop",
              "label": "当前数据块：最多 3 次尝试",
              "guard": "当前块尚未确认，且尝试次数小于 3；收到块确认即退出",
              "min": 1,
              "max": 3,
              "steps": [
                {
                  "id": "block",
                  "from": "host",
                  "to": "mcu",
                  "label": "写入数据块",
                  "protocol": "binary:packet"
                },
                {
                  "id": "write",
                  "from": "mcu",
                  "to": "flash",
                  "label": "编程 Flash",
                  "mode": "call"
                },
                {
                  "id": "result",
                  "kind": "alt",
                  "branches": [
                    {
                      "id": "ok",
                      "guard": "校验通过",
                      "steps": [
                        {
                          "id": "ack",
                          "from": "mcu",
                          "to": "host",
                          "label": "块确认，结束本块重试",
                          "mode": "signal",
                          "replyTo": "block"
                        }
                      ]
                    },
                    {
                      "id": "retry",
                      "otherwise": true,
                      "steps": [
                        {
                          "id": "nack",
                          "from": "mcu",
                          "to": "host",
                          "label": "校验失败，按剩余次数重传",
                          "mode": "signal",
                          "replyTo": "block"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "id": "block-failure",
              "kind": "opt",
              "guard": "3 次尝试结束后，当前块仍未确认",
              "steps": [
                {
                  "id": "stop-upgrade",
                  "kind": "note",
                  "on": [
                    "mcu"
                  ],
                  "text": "标记升级失败并停止分块，不再发送下一块。"
                }
              ]
            }
          ]
        },
        {
          "id": "outcome",
          "kind": "alt",
          "label": "升级结局",
          "branches": [
            {
              "id": "success",
              "guard": "所有数据块均已确认，且没有升级失败",
              "steps": [
                {
                  "id": "background",
                  "kind": "par",
                  "label": "进度通知与温度监测",
                  "branches": [
                    {
                      "id": "notify",
                      "label": "升级进度",
                      "steps": [
                        {
                          "id": "progress",
                          "from": "mcu",
                          "to": "host",
                          "label": "上报进度",
                          "mode": "signal"
                        }
                      ]
                    },
                    {
                      "id": "telemetry",
                      "label": "独立监测",
                      "steps": [
                        {
                          "id": "poll",
                          "from": "monitor",
                          "to": "flash",
                          "label": "读取温度",
                          "mode": "call"
                        },
                        {
                          "id": "temperature",
                          "from": "flash",
                          "to": "monitor",
                          "label": "温度采样",
                          "mode": "return",
                          "replyTo": "poll"
                        }
                      ]
                    }
                  ]
                },
                {
                  "id": "done",
                  "from": "mcu",
                  "to": "host",
                  "label": "升级成功",
                  "mode": "return",
                  "replyTo": "begin"
                }
              ]
            },
            {
              "id": "failure",
              "otherwise": true,
              "label": "当前块尝试耗尽",
              "steps": [
                {
                  "id": "failed",
                  "from": "mcu",
                  "to": "host",
                  "label": "升级失败：停止写入",
                  "mode": "return",
                  "replyTo": "begin"
                }
              ]
            }
          ]
        }
      ],
      "constraints": [
        {
          "id": "timeout",
          "kind": "duration",
          "from": {
            "message": "begin",
            "end": "send"
          },
          "to": {
            "message": "done",
            "end": "receive"
          },
          "max": 5,
          "unit": "s",
          "label": "成功升级总时限（规范约束）"
        }
      ],
      "source": {
        "file": "docs/ir/authoring/sequences.json",
        "selector": "seq:upgrade"
      }
    }
  ],
  "views": [
    {
      "id": "view:upgrade",
      "kind": "sequence",
      "model": "seq:upgrade",
      "expandedCalls": [
        "authenticate"
      ],
      "source": {
        "file": "docs/ir/authoring/sequences.json",
        "selector": "view:upgrade"
      }
    },
    {
      "id": "view:upgrade-overview",
      "kind": "sequence",
      "model": "seq:upgrade",
      "collapsed": [
        "write-loop",
        "background"
      ],
      "source": {
        "file": "docs/ir/authoring/sequences.json",
        "selector": "view:upgrade-overview"
      }
    }
  ]
}
