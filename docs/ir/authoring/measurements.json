  "views": [
    {
      "id": "plot:simple",
      "kind": "plot",
      "label": "原始时延趋势",
      "data": "table:measurements",
      "mark": "line",
      "transform": [
        {
          "filter": {
            "field": "mode",
            "equal": "A"
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "sample"
        },
        "y": {
          "field": "latency"
        }
      },
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:simple"
      }
    },
    {
      "id": "plot:distribution",
      "kind": "plot",
      "label": "不同负载下的时延分布",
      "data": "table:measurements",
      "facet": {
        "field": "mode",
        "columns": 2
      },
      "spec": {
        "layer": [
          {
            "mark": "boxplot",
            "encoding": {
              "x": {
                "field": "load",
                "type": "ordinal"
              },
              "y": {
                "field": "latency"
              },
              "color": {
                "field": "mode"
              }
            }
          },
          {
            "mark": "point",
            "encoding": {
              "x": {
                "field": "load",
                "type": "ordinal"
              },
              "y": {
                "field": "latency"
              },
              "color": {
                "field": "mode"
              }
            }
          }
        ]
      },
      "width": 350,
      "height": 270,
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:distribution"
      }
    },
    {
      "id": "plot:quantile",
      "kind": "plot",
      "label": "跨负载混合样本的时延分位数（R-7）",
      "data": "table:measurements",
      "transform": [
        {
          "quantile": "latency",
          "probs": [
            0.5,
            0.9,
            0.99
          ],
          "groupby": [
            "mode"
          ],
          "as": [
            "probability",
            "latencyQ"
          ],
          "method": "linear"
        }
      ],
      "mark": "line",
      "encoding": {
        "x": {
          "field": "probability",
          "title": "分位概率"
        },
        "y": {
          "field": "latencyQ",
          "title": "混合样本时延分位数 (us)"
        },
        "color": {
          "field": "mode"
        }
      },
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:quantile"
      }
    },
    {
      "id": "plot:load-trend",
      "kind": "plot",
      "label": "两种配置随负载变化的平均时延",
      "data": "table:measurements",
      "transform": [
        {
          "aggregate": [
            {
              "op": "mean",
              "field": "latency",
              "as": "meanLatency"
            }
          ],
          "groupby": [
            "mode",
            "load"
          ]
        }
      ],
      "mark": "line",
      "encoding": {
        "x": {
          "field": "load"
        },
        "y": {
          "field": "meanLatency",
          "title": "平均时延 (us)"
        },
        "color": {
          "field": "mode"
        }
      },
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:load-trend"
      }
    },
    {
      "id": "plot:load-quantile",
      "kind": "plot",
      "label": "各配置与负载内的时延分位数（R-7）",
      "data": "table:measurements",
      "facet": {
        "field": "mode",
        "columns": 2
      },
      "spec": {
        "transform": [
          {
            "quantile": "latency",
            "probs": [
              0.5,
              0.9,
              0.99
            ],
            "groupby": [
              "load"
            ],
            "as": [
              "probability",
              "latencyQ"
            ],
            "method": "linear"
          }
        ],
        "mark": "line",
        "encoding": {
          "x": {
            "field": "load"
          },
          "y": {
            "field": "latencyQ",
            "title": "时延分位数 (us)"
          },
          "color": {
            "field": "probability",
            "type": "ordinal",
            "title": "分位概率"
          }
        }
      },
      "width": 350,
      "height": 270,
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:load-quantile"
      }
    }
  ]
}
