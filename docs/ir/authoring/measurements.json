  "views": [
    {
      "id": "plot:simple",
      "kind": "plot",
      "label": "原始时延趋势",
      "data": "table:measurements",
      "mark": "line",
      "transform": [
        {
          "filter": {
            "field": "mode",
            "equal": "A"
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "sample"
        },
        "y": {
          "field": "latency"
        }
      },
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:simple"
      }
    },
    {
      "id": "plot:distribution",
      "kind": "plot",
      "label": "不同负载下的时延分布",
      "data": "table:measurements",
      "facet": {
        "field": "mode",
        "columns": 2
      },
      "spec": {
        "layer": [
          {
            "mark": "boxplot",
            "encoding": {
              "x": {
                "field": "load",
                "type": "ordinal"
              },
              "y": {
                "field": "latency"
              },
              "color": {
                "field": "mode"
              }
            }
          },
          {
            "mark": "point",
            "encoding": {
              "x": {
                "field": "load",
                "type": "ordinal"
              },
              "y": {
                "field": "latency"
              },
              "color": {
                "field": "mode"
              }
            }
          }
        ]
      },
      "width": 350,
      "height": 270,
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:distribution"
      }
    },
    {
      "id": "plot:quantile",
      "kind": "plot",
      "label": "时延分位数（R-7）",
      "data": "table:measurements",
      "transform": [
        {
          "quantile": "latency",
          "probs": [
            0.5,
            0.9,
            0.99
          ],
          "groupby": [
            "mode"
          ],
          "as": [
            "probability",
            "latencyQ"
          ],
          "method": "linear"
        }
      ],
      "mark": "line",
      "encoding": {
        "x": {
          "field": "probability"
        },
        "y": {
          "field": "latencyQ"
        },
        "color": {
          "field": "mode"
        }
      },
      "source": {
        "file": "docs/ir/authoring/measurements.json",
        "selector": "plot:quantile"
      }
    }
  ]
