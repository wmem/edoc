{
  "stateMachines": [],
  "flowcharts": [
    {
      "id": "example:fulfillment",
      "kind": "flowchart",
      "label": "订单履约 · 修正循环、失败出口与并行收尾",
      "lanes": [
        {
          "id": "sales",
          "label": "订单管理"
        },
        {
          "id": "warehouse",
          "label": "仓储与生产"
        },
        {
          "id": "finance",
          "label": "财务"
        }
      ],
      "nodes": [
        {
          "id": "start",
          "lane": "sales",
          "kind": "start"
        },
        {
          "id": "record",
          "label": "录入订单",
          "lane": "sales"
        },
        {
          "id": "validate",
          "label": "资料完整？",
          "lane": "sales",
          "kind": "decision"
        },
        {
          "id": "revise",
          "label": "请求并录入修正",
          "lane": "sales"
        },
        {
          "id": "inventory",
          "label": "检查库存",
          "lane": "warehouse"
        },
        {
          "id": "stock",
          "label": "库存充足？",
          "lane": "warehouse",
          "kind": "decision"
        },
        {
          "id": "retrieve",
          "label": "提取库存商品",
          "lane": "warehouse"
        },
        {
          "id": "manufacture",
          "label": "备料并生产",
          "lane": "warehouse"
        },
        {
          "id": "production",
          "label": "生产成功？",
          "lane": "warehouse",
          "kind": "decision"
        },
        {
          "id": "cancel",
          "label": "取消订单并处置材料",
          "lane": "warehouse"
        },
        {
          "id": "failure",
          "label": "履约失败",
          "lane": "warehouse",
          "kind": "end"
        },
        {
          "id": "merge",
          "label": "商品就绪",
          "lane": "warehouse",
          "kind": "merge"
        },
        {
          "id": "fork",
          "lane": "warehouse",
          "kind": "fork"
        },
        {
          "id": "ship",
          "label": "包装并发货",
          "lane": "warehouse"
        },
        {
          "id": "invoice",
          "label": "发送发票",
          "lane": "finance"
        },
        {
          "id": "payment",
          "label": "等待付款",
          "lane": "finance",
          "wait": "已收到付款",
          "kind": "wait"
        },
        {
          "id": "join",
          "lane": "sales",
          "kind": "join"
        },
        {
          "id": "archive",
          "label": "归档订单",
          "lane": "sales"
        },
        {
          "id": "end",
          "label": "履约完成",
          "lane": "sales",
          "kind": "end"
        }
      ],
      "edges": [
        {
          "id": "edge-begin",
          "from": "start",
          "to": "record"
        },
        {
          "id": "edge-validate",
          "from": "record",
          "to": "validate"
        },
        {
          "id": "edge-revise",
          "from": "validate",
          "to": "revise",
          "otherwise": true
        },
        {
          "id": "edge-recheck",
          "from": "revise",
          "to": "record"
        },
        {
          "id": "edge-inventory",
          "from": "validate",
          "to": "inventory",
          "guard": "是"
        },
        {
          "id": "edge-stock",
          "from": "inventory",
          "to": "stock"
        },
        {
          "id": "edge-retrieve",
          "from": "stock",
          "to": "retrieve",
          "guard": "是"
        },
        {
          "id": "edge-make",
          "from": "stock",
          "to": "manufacture",
          "otherwise": true
        },
        {
          "id": "edge-production",
          "from": "manufacture",
          "to": "production"
        },
        {
          "id": "edge-success",
          "from": "production",
          "to": "merge",
          "guard": "是"
        },
        {
          "id": "edge-cancel",
          "from": "production",
          "to": "cancel",
          "otherwise": true
        },
        {
          "id": "edge-failure",
          "from": "cancel",
          "to": "failure"
        },
        {
          "id": "edge-retrieved",
          "from": "retrieve",
          "to": "merge"
        },
        {
          "id": "edge-parallel",
          "from": "merge",
          "to": "fork"
        },
        {
          "id": "edge-ship",
          "from": "fork",
          "to": "ship"
        },
        {
          "id": "edge-invoice",
          "from": "fork",
          "to": "invoice"
        },
        {
          "id": "edge-await",
          "from": "invoice",
          "to": "payment"
        },
        {
          "id": "edge-shipped",
          "from": "ship",
          "to": "join"
        },
        {
          "id": "edge-paid",
          "from": "payment",
          "to": "join"
        },
        {
          "id": "edge-archive",
          "from": "join",
          "to": "archive"
        },
        {
          "id": "edge-end",
          "from": "archive",
          "to": "end"
        }
      ]
    }
  ]
}
