{
  "stateMachines": [
    {
      "id": "example:microwave",
      "kind": "state-machine",
      "label": "并行微波炉 · 烹饪与门状态",
      "initial": "oven",
      "semantics": {
        "profile": "SCXML 示意；守卫表达式不执行"
      },
      "states": [
        {
          "id": "oven",
          "kind": "parallel",
          "label": "微波炉"
        },
        {
          "id": "off",
          "region": "engine",
          "label": "停止"
        },
        {
          "id": "on",
          "region": "engine",
          "kind": "composite",
          "label": "已启动"
        },
        {
          "id": "idle",
          "region": "working",
          "label": "暂停"
        },
        {
          "id": "cooking",
          "region": "working",
          "label": "加热中"
        },
        {
          "id": "closed",
          "region": "door",
          "label": "门关闭"
        },
        {
          "id": "open",
          "region": "door",
          "label": "门打开"
        }
      ],
      "regions": [
        {
          "id": "engine",
          "owner": "oven",
          "label": "烹饪控制",
          "initial": "off"
        },
        {
          "id": "working",
          "owner": "on",
          "label": "运行阶段",
          "initial": "idle"
        },
        {
          "id": "door",
          "owner": "oven",
          "label": "炉门",
          "initial": "closed"
        }
      ],
      "transitions": [
        {
          "id": "power-on",
          "from": "off",
          "to": "on",
          "trigger": "启动"
        },
        {
          "id": "power-off",
          "from": "on",
          "to": "off",
          "trigger": "停止"
        },
        {
          "id": "timeout",
          "from": "on",
          "to": "off",
          "trigger": {
            "kind": "always"
          },
          "guard": "计时 ≥ 设定时长"
        },
        {
          "id": "heat",
          "from": "idle",
          "to": "cooking",
          "trigger": {
            "kind": "always"
          },
          "guard": "门处于关闭状态"
        },
        {
          "id": "pause",
          "from": "cooking",
          "to": "idle",
          "trigger": {
            "kind": "always"
          },
          "guard": "门处于打开状态"
        },
        {
          "id": "tick",
          "from": "cooking",
          "to": "cooking",
          "kind": "internal",
          "trigger": "每秒计时事件",
          "actions": [
            "计时加一"
          ]
        },
        {
          "id": "open-door",
          "from": "closed",
          "to": "open",
          "trigger": "开门"
        },
        {
          "id": "close-door",
          "from": "open",
          "to": "closed",
          "trigger": "关门"
        }
      ]
    }
  ]
}
