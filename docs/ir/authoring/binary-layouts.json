{
  "binaryLayouts": [
    {
      "id": "binary:descriptor",
      "kind": "binary-layout",
      "label": "固定 64 bit 描述符",
      "byteOrder": "little",
      "fields": [
        {
          "id": "opcode",
          "label": "操作码",
          "size": 8
        },
        {
          "id": "flags",
          "label": "标志",
          "size": 8
        },
        {
          "id": "length",
          "label": "长度",
          "size": 16
        },
        {
          "id": "address",
          "label": "缓冲区地址",
          "size": 32
        }
      ],
      "source": {
        "file": "docs/ir/authoring/binary-layouts.json",
        "selector": "binary:descriptor"
      }
    },
    {
      "id": "binary:packet",
      "kind": "binary-layout",
      "label": "升级报文：公共头、类型头与负载",
      "unit": "byte",
      "byteOrder": "big",
      "bitOrder": "msb-first",
      "fields": [
        {
          "id": "type",
          "label": "类型",
          "size": 1,
          "description": "选择类型头：1 为数据块，2 为控制消息；其他类型码在本示例中保留。",
          "enums": {
            "1": "数据块",
            "2": "控制消息"
          }
        },
        {
          "id": "len",
          "label": "负载长度",
          "size": 2,
          "description": "负载 payload 的字节数，不包含公共头、类型头、扩展、对齐和 CRC。"
        },
        {
          "id": "extension",
          "label": "扩展标志",
          "size": 1,
          "description": "声明是否携带时间戳扩展；场景使用同名布尔键选择对应结构。",
          "enums": {
            "0": "不带时间戳",
            "1": "携带时间戳"
          }
        },
        {
          "id": "header",
          "kind": "choice",
          "selector": "type",
          "branches": [
            {
              "id": "data",
              "when": 1,
              "fields": [
                {
                  "id": "seqno",
                  "label": "序号",
                  "size": 4,
                  "description": "数据块序号；同一块重传时保持相同序号。"
                }
              ],
              "label": "数据块头"
            },
            {
              "id": "control",
              "otherwise": true,
              "fields": [
                {
                  "id": "command",
                  "label": "命令",
                  "size": 2,
                  "value": "0x0001",
                  "description": "本示例的控制消息使用开始升级命令。"
                }
              ],
              "label": "控制消息头"
            }
          ],
          "label": "类型相关头"
        },
        {
          "id": "extra",
          "kind": "optional",
          "condition": "extension",
          "fields": [
            {
              "id": "timestamp",
              "label": "时间戳",
              "size": 8,
              "description": "发送端时间戳，仅带扩展时存在；本示例未规定时间基准和单位。"
            }
          ],
          "label": "时间戳扩展"
        },
        {
          "id": "payload",
          "label": "负载",
          "size": {
            "field": "len",
            "unit": "byte"
          },
          "description": "数据块内容或控制消息负载，长度由 len 给出。"
        },
        {
          "id": "pad",
          "kind": "align",
          "to": 4,
          "description": "在 CRC 前将当前流偏移对齐到 4 字节，填充字节内容未声明。",
          "label": "对齐填充"
        },
        {
          "id": "crc",
          "label": "CRC32",
          "size": 4,
          "description": "CRC32 字段；本示例不规定多项式、初值与覆盖算法，不能据布局推断。"
        }
      ],
      "source": {
        "file": "docs/ir/authoring/binary-layouts.json",
        "selector": "binary:packet"
      }
    },
    {
      "id": "binary:scatter",
      "kind": "binary-layout",
      "label": "描述符链：重复与嵌套",
      "fields": [
        {
          "id": "count",
          "label": "描述符数",
          "size": 16
        },
        {
          "id": "reserved",
          "kind": "reserved",
          "size": 16
        },
        {
          "id": "items",
          "label": "描述符数组",
          "kind": "repeat",
          "count": {
            "field": "count"
          },
          "element": {
            "id": "descriptor",
            "kind": "ref",
            "model": "binary:descriptor"
          }
        }
      ],
      "source": {
        "file": "docs/ir/authoring/binary-layouts.json",
        "selector": "binary:scatter"
      }
    }
  ],
  "views": [
    {
      "id": "view:packet-sample",
      "kind": "binary-layout",
      "model": "binary:packet",
      "bitsPerRow": 32,
      "values": {
        "type": 1,
        "len": 12,
        "extension": true
      },
      "source": {
        "file": "docs/ir/authoring/binary-layouts.json",
        "selector": "view:packet-sample"
      }
    },
    {
      "id": "view:packet-control",
      "kind": "binary-layout",
      "model": "binary:packet",
      "bitsPerRow": 32,
      "values": {
        "type": 2,
        "len": 0,
        "extension": false
      },
      "source": {
        "file": "docs/ir/authoring/binary-layouts.json",
        "selector": "view:packet-control"
      }
    },
    {
      "id": "view:packet-overview",
      "kind": "binary-layout",
      "model": "binary:packet",
      "collapsed": [
        "header",
        "extra"
      ],
      "source": {
        "file": "docs/ir/authoring/binary-layouts.json",
        "selector": "view:packet-overview"
      }
    }
  ]
}
