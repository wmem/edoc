      "direction": {
        "sources": [
          "mac:control"
        ],
        "targets": [
          "mac:tx"
        ]
      }
    },
    {
      "id": "mac:rel.rxctl",
      "kind": "connection",
      "class": "control",
      "endpoints": [
        "mac:control",
        "mac:rx"
      ],
      "label": "configuration",
      "direction": {
        "sources": [
          "mac:control"
        ],
        "targets": [
          "mac:rx"
        ]
      }
    },
    {
      "id": "mac:rel.rxfifo",
      "kind": "connection",
      "class": "data",
      "endpoints": [
        "mac:rx",
        "mac:fifo"
      ],
      "label": "received frame",
      "direction": {
        "sources": [
          "mac:rx"
        ],
        "targets": [
          "mac:fifo"
        ]
      }
    },
    {
      "id": "mac:rel.event",
      "kind": "connection",
      "class": "event",
      "endpoints": [
        "mac:fifo",
        "mac:control"
      ],
      "label": "occupancy event",
      "direction": {
        "sources": [
          "mac:fifo"
        ],
        "targets": [
          "mac:control"
        ]
      }
    },
    {
      "id": "mac:transition.start",
      "kind": "connection",
      "class": "data",
      "label": "valid",
      "endpoints": [
        "mac:state.idle",
        "mac:state.active"
      ],
      "direction": {
        "sources": [
          "mac:state.idle"
        ],
        "targets": [
          "mac:state.active"
        ]
      }
    },
    {
      "id": "mac:transition.stall",
      "kind": "connection",
      "class": "control",
      "label": "!ready",
      "endpoints": [
        "mac:state.active",
        "mac:state.hold"
      ],
      "direction": {
        "sources": [
          "mac:state.active"
        ],
        "targets": [
          "mac:state.hold"
        ]
      }
    },
    {
      "id": "mac:transition.resume",
      "kind": "connection",
      "class": "event",
      "label": "ready",
      "endpoints": [
        "mac:state.hold",
        "mac:state.active"
      ],
      "direction": {
        "sources": [
          "mac:state.hold"
        ],
        "targets": [
          "mac:state.active"
        ]
      }
    }
