{
  "name": "edoc",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "edoc": "./dist/packages/cli/edoc.js"
  },
  "scripts": {
    "edoc": "node packages/cli/edoc.ts",
    "test:schema": "node --test tests/schema.test.ts",
    "test:core": "node --test tests/core.test.ts",
    "test:query": "node --test tests/query.test.ts",
    "test:cli": "node --test tests/cli.test.ts",
    "typecheck": "tsc --noEmit",
    "test:graph": "node --test tests/graph.test.ts",
    "test:layout": "node --test tests/layout.test.ts",
    "test:document": "node --test tests/document.test.ts",
    "test:outline": "node --test tests/outline.test.ts",
    "test:adapter": "node --test tests/adapter.test.ts",
    "test:browser": "node --test tests/browser.test.ts",
    "test:pdf": "node --test tests/pdf.test.ts",
    "test:quality": "node --test tests/quality.test.ts",
    "demo": "node scripts/demo.ts",
    "demo:build": "node scripts/demo.ts --build",
    "test:wave": "node --test tests/wave.test.ts",
    "test:interface": "node --test tests/interface.test.ts tests/interface-browser.test.ts",
    "build:package": "node scripts/build-package.mjs",
    "prepare": "npm run build:package",
    "test:project": "node --test tests/project.test.ts",
    "test:package": "node --test tests/package.test.ts",
    "test:reader": "node --test tests/reader.test.ts",
    "test:reader-browser": "node --test tests/reader-browser.test.ts",
    "docs:build": "node packages/cli/edoc.ts",
    "docs:dev": "node scripts/docs.ts",
    "docs:pdf": "node packages/cli/edoc.ts build --format pdf",
    "test:read": "node --test tests/read.test.ts",
    "test:manual": "node --test tests/manual.test.ts tests/manual-capabilities.test.ts",
    "test:manual-browser": "node --test tests/manual-browser.test.ts tests/manual-capabilities-browser.test.ts"
  },
  "dependencies": {
    "@antv/x6": "3.1.8",
    "@fontsource/noto-sans-sc": "5.3.1",
    "@markdoc/markdoc": "0.5.11",
    "ajv": "8.20.0",
    "elkjs": "0.12.1",
    "pdfjs-dist": "6.4.299",
    "playwright": "1.64.1",
    "tslib": "2.9.1",
    "vite": "8.3.5",
    "wavedrom": "3.8.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "docs",
    "templates"
  ],
  "exports": {
    ".": "./dist/packages/core/index.js"
  }
}
